{
  "name": "@dashility/client",
  "version": "0.1.0",
  "description": "Script analytics des sites gérés par Dashility",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/K0Konut/Headless_CMS.git",
    "directory": "packages/client"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/check-size.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "vite": "^8.3.5"
  }
}
